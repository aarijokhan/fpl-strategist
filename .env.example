# Required
OPENAI_API_KEY=

# Optional — only needed for --provider anthropic or cross-family judge
ANTHROPIC_API_KEY=

# Optional — Langfuse tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# LLM provider: "openai" (default) or "anthropic"
FPL_LLM_PROVIDER=openai
